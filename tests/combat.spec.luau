local Rules = require("../src/shared/CombatRules")

return function(test)
	test("sword damage is deterministic", function()
		assert(Rules.damage(28, 0) == 28)
		assert(Rules.damage(28, 100) == 14)
	end)
	test("negative damage and armor cannot heal", function()
		assert(Rules.damage(-20, 0) == 0)
		assert(Rules.damage(20, -100) == 20)
	end)
	test("NaN and infinity never become damage", function()
		assert(Rules.damage(0 / 0, 0) == 0)
		assert(Rules.damage(math.huge, 0) == 0)
		assert(Rules.damage(10, math.huge) == 0)
	end)
	test("attack range rejects invalid distances", function()
		assert(Rules.withinRange(10, 10))
		assert(not Rules.withinRange(10.001, 10))
		assert(not Rules.withinRange(-1, 10))
		assert(not Rules.withinRange(0 / 0, 10))
	end)
	test("server cooldown rejects repeated and reversed clocks", function()
		assert(Rules.cooldownReady(1, nil, 0.55))
		assert(not Rules.cooldownReady(1.1, 1, 0.55))
		assert(Rules.cooldownReady(2, 1, 0.55))
		assert(not Rules.cooldownReady(0, 1, 0.55))
		assert(not Rules.cooldownReady(math.huge, 1, 0.55))
	end)
	test("sword requires target in front of attacker", function()
		assert(Rules.isInFront(1))
		assert(not Rules.isInFront(-1))
		assert(not Rules.isInFront(0 / 0))
	end)
end
